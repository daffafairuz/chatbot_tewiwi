<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin</title>
    <link rel="icon" type="image/png" href="/logo/logo_tewiwi.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-page: #f7eff2;
            --card-bg: #ffffff;
            --primary-blue: #163387;
            --primary-blue-hover: #102669;
            --soft-blue-bg: #f2f5fc;
            --text-dark: #222634;
            --text-muted: #5e7199;
            --divider: #edf1f8;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: var(--bg-page);
            margin: 0;
            padding: 20px;
            color: var(--text-dark);
        }

        .card {
            background: var(--card-bg);
            padding: 32px 28px;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(22, 51, 135, 0.06);
            width: 100%;
            max-width: 380px;
        }

        .brand-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .brand-logo {
            height: 76px;
            width: auto;
            object-fit: contain;
            margin-bottom: 12px;
        }

        h3 {
            margin: 0 0 6px 0;
            font-size: 20px;
            font-weight: 700;
            color: var(--primary-blue);
        }

        .subtitle {
            width: 100%;
            margin: 0 0 20px 0;
            font-size: 13.5px;
            color: var(--text-muted);
            padding-bottom: 14px;
            border-bottom: 1px solid var(--divider);
        }

        .form-box {
            background: var(--soft-blue-bg);
            padding: 18px;
            border-radius: 14px;
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 6px;
        }

        input {
            width: 100%;
            padding: 11px 14px;
            margin: 0 0 14px;
            border: 1.5px solid #d5dff2;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: var(--text-dark);
            background: #ffffff;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input:last-of-type {
            margin-bottom: 0;
        }

        input:focus {
            outline: none;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px rgba(22, 51, 135, 0.1);
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        button {
            width: 100%;
            padding: 12px 20px;
            background: var(--primary-blue);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-family: inherit;
            font-size: 14.5px;
            font-weight: 700;
            transition: background-color 0.2s;
        }

        button:hover {
            background: var(--primary-blue-hover);
        }

        .btn-outline {
            display: block;
            text-align: center;
            text-decoration: none;
            padding: 10px 16px;
            border: 1.5px solid var(--primary-blue);
            color: var(--primary-blue);
            border-radius: 12px;
            font-size: 13.5px;
            font-weight: 700;
            transition: background-color 0.2s;
        }

        .btn-outline:hover {
            background: var(--soft-blue-bg);
        }

        .error {
            background: #fff0f2;
            color: #c81e3a;
            border: 1px solid #fecdd6;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 500;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="brand-header">
            <img src="/logo/logo_tewiwi.png" alt="Logo Téwiwi Bakehouse" class="brand-logo">
            <h3>Login Admin</h3>
            <p class="subtitle">Masuk untuk mengelola dokumen referensi chatbot.</p>
        </div>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/login" method="POST">
            <div class="form-box">
                <label>Username</label>
                <input type="text" name="username" required autocomplete="username">
                <label>Password</label>
                <input type="password" name="password" required autocomplete="current-password">
            </div>
            <div class="btn-group">
                <button type="submit">Masuk</button>
                <a href="/" class="btn-outline">Kembali ke Chatbot</a>
            </div>
        </form>
    </div>
</body>
</html>
