<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin - Kelola PDF</title>
    <link rel="icon" type="image/png" href="/logo/logo_tewiwi.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-page: #f7eff2;
            --card-bg: #ffffff;
            --primary-blue: #163387;
            --primary-blue-hover: #102669;
            --soft-blue-bg: #f2f5fc;
            --soft-blue-border: #e3eaf8;
            --text-dark: #222634;
            --text-muted: #5e7199;
            --divider: #edf1f8;
            --danger: #c81e3a;
            --danger-bg: #fff0f2;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-page);
            color: var(--text-dark);
            margin: 0;
            padding: 36px 16px;
        }

        .container {
            max-width: 820px;
            margin: 0 auto;
            background: var(--card-bg);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 8px 30px rgba(22, 51, 135, 0.06);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--divider);
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo {
            height: 48px;
            width: auto;
            object-fit: contain;
            border-radius: 8px;
        }

        .header h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: var(--primary-blue);
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--primary-blue);
            margin: 0 0 12px 0;
        }

        .soft-box {
            background: var(--soft-blue-bg);
            padding: 20px;
            border-radius: 16px;
            margin-bottom: 28px;
        }

        .upload-form {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        input[type="file"] {
            flex: 1;
            min-width: 220px;
            padding: 10px 14px;
            background: #ffffff;
            border: 1.5px solid #d5dff2;
            border-radius: 10px;
            font-family: inherit;
            font-size: 13.5px;
            color: var(--text-dark);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 13px 12px;
            text-align: left;
            border-bottom: 1px solid var(--divider);
            font-size: 14px;
        }

        th {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 13px;
        }

        .badge-aktif {
            background: var(--primary-blue);
            color: #ffffff;
            padding: 5px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
        }

        .badge-nonaktif {
            color: var(--text-muted);
            font-size: 13px;
            font-weight: 500;
        }

        .btn {
            padding: 9px 16px;
            border-radius: 10px;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            border: none;
        }

        .btn-primary {
            background: var(--primary-blue);
            color: #ffffff;
        }

        .btn-primary:hover {
            background: var(--primary-blue-hover);
        }

        .btn-outline {
            background: #ffffff;
            color: var(--primary-blue);
            border: 1.5px solid var(--primary-blue);
        }

        .btn-outline:hover {
            background: var(--soft-blue-bg);
        }

        .btn-danger {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1.5px solid #fecdd6;
        }

        .btn-danger:hover {
            background: #ffe0e6;
        }

        .actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .empty-state {
            text-align: center;
            color: var(--text-muted);
            padding: 24px 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="header-brand">
                <img src="/logo/logo_tewiwi.png" alt="Logo Téwiwi Bakehouse" class="brand-logo">
                <h2>Dashboard Admin</h2>
            </div>
            <div class="header-actions">
                <a href="/" class="btn btn-outline">Lihat Chatbot</a>
                <a href="/logout" class="btn btn-danger">Logout</a>
            </div>
        </div>

        <h3 class="section-title">Unggah Dokumen PDF Baru</h3>
        <div class="soft-box">
            <form action="/admin/upload" method="POST" enctype="multipart/form-data" class="upload-form">
                <input type="file" name="file_pdf" accept="application/pdf" required>
                <button type="submit" class="btn btn-primary">Unggah & Aktifkan</button>
            </form>
        </div>

        <h3 class="section-title">Daftar Dokumen PDF</h3>
        <table>
            <thead>
                <tr>
                    <th>Nama File</th>
                    <th>Status</th>
                    <th>Tanggal Unggah</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (dokumenList.length > 0) { %>
                    <% dokumenList.forEach(doc => { %>
                        <tr>
                            <td style="font-weight: 600;"><%= doc.nama_file %></td>
                            <td>
                                <% if (doc.is_active) { %>
                                    <span class="badge-aktif">Aktif</span>
                                <% } else { %>
                                    <span class="badge-nonaktif">Nonaktif</span>
                                <% } %>
                            </td>
                            <td style="color: var(--text-muted);"><%= new Date(doc.uploaded_at).toLocaleString('id-ID') %></td>
                            <td class="actions">
                                <% if (!doc.is_active) { %>
                                    <form action="/admin/aktifkan/<%= doc.id %>" method="POST" style="margin: 0;">
                                        <button type="submit" class="btn btn-outline">Aktifkan</button>
                                    </form>
                                <% } %>
                                <form action="/admin/hapus/<%= doc.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Hapus dokumen ini?')">
                                    <button type="submit" class="btn btn-danger">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="4" class="empty-state">Belum ada dokumen.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>
